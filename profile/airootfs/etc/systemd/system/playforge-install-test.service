[Unit]
Description=Playforge Installationstest
After=playforge-live-setup.service network-online.target
Wants=network-online.target
ConditionKernelCommandLine=playforge.install_test=1

[Service]
Type=oneshot
ExecStart=/usr/local/lib/playforge/install-test
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=0
