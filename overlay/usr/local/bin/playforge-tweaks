#!/usr/bin/env bash
# Playforge – Leistungsprofile und Statusanzeige
set -euo pipefail

profile_dir="/etc/playforge"
profile_file="$profile_dir/profile"

usage() {
    cat <<'EOF'
Nutzung: playforge-tweaks <Befehl>

Befehle:
  status             Aktuellen Zustand anzeigen
  apply              Gespeichertes Profil (erneut) anwenden
  performance        Profil "performance": maximale CPU-Leistung
  balanced           Profil "balanced": ausgewogen, leiser
  reset              Gespeichertes Profil entfernen, balanced anwenden

Das Profil wird in /etc/playforge/profile gespeichert und beim Booten von
playforge-profile.service angewendet. Änderungen benötigen root-Rechte.
EOF
}

have() { command -v "$1" >/dev/null 2>&1; }

require_root() {
    if [[ $EUID -ne 0 ]]; then
        printf 'Bitte mit root-Rechten ausführen (sudo playforge-tweaks %s).\n' "${1:-}" >&2
        exit 1
    fi
}

show_status() {
    printf 'Playforge – Status\n'
    printf '  Kernel               : %s\n' "$(uname -r)"
    printf '  Profil (gespeichert) : %s\n' "$(cat "$profile_file" 2>/dev/null || echo 'balanced (Standard)')"

    if have powerprofilesctl; then
        printf '  Power-Profile-Daemon : %s\n' "$(powerprofilesctl get 2>/dev/null || echo 'n/a')"
    else
        printf '  Power-Profile-Daemon : nicht installiert\n'
    fi

    if [[ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]]; then
        printf '  CPU-Governor         : %s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"
    fi
    if [[ -r /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference ]]; then
        printf '  EPP                  : %s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference)"
    fi
    if [[ -r /sys/firmware/acpi/platform_profile ]]; then
        printf '  Platform-Profil      : %s\n' "$(cat /sys/firmware/acpi/platform_profile)"
    fi

    if have zramctl; then
        local zram
        zram="$(zramctl --noheadings --output NAME,ALGORITHM,DISKSIZE 2>/dev/null | tr '\n' ' ' || true)"
        printf '  ZRAM                 : %s\n' "${zram:-nicht aktiv}"
    fi

    printf '  vm.max_map_count     : %s\n' "$(sysctl -n vm.max_map_count 2>/dev/null || echo '?')"
    printf '  TCP-Kongestion       : %s\n' "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '?')"

    if have gamemoderun; then
        printf '  gamemode             : installiert\n'
    else
        printf '  gamemode             : NICHT installiert\n'
    fi
    if have mangohud; then
        printf '  MangoHud             : installiert\n'
    else
        printf '  MangoHud             : NICHT installiert\n'
    fi

    printf '\n  Grafik:\n'
    if have lspci; then
        lspci -nnk 2>/dev/null | awk '
            /VGA compatible controller|3D controller|Display controller/ { print "    " $0; show=1; next }
            show && /Kernel driver in use/ { print "    " $0; show=0 }
        '
    else
        printf '    lspci nicht verfügbar\n'
    fi
}

pick_governor() {
    local wanted="$1" available governor candidate
    available="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null || true)"
    [[ -n "$available" ]] || return 0
    governor=""
    case "$wanted" in
        performance)
            governor="performance"
            ;;
        balanced)
            for candidate in powersave schedutil ondemand; do
                if [[ " $available " == *" $candidate "* ]]; then
                    governor="$candidate"
                    break
                fi
            done
            ;;
    esac
    [[ -n "$governor" ]] || return 0
    local path
    for path in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [[ -w "$path" ]] && printf '%s\n' "$governor" >"$path" 2>/dev/null || true
    done
}

set_epp() {
    local value="$1" path
    [[ -w /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference ]] || return 0
    for path in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [[ -w "$path" ]] && printf '%s\n' "$value" >"$path" 2>/dev/null || true
    done
}

set_platform_profile() {
    local value="$1"
    if have powerprofilesctl; then
        return 0
    fi
    [[ -w /sys/firmware/acpi/platform_profile ]] || return 0
    printf '%s\n' "$value" >/sys/firmware/acpi/platform_profile 2>/dev/null || true
}

apply_profile() {
    local profile
    profile="$(cat "$profile_file" 2>/dev/null || echo balanced)"
    case "$profile" in
        performance | balanced) ;;
        *)
            printf 'Ungültiges Profil "%s" in %s – nutze balanced.\n' "$profile" "$profile_file" >&2
            profile="balanced"
            ;;
    esac

    if have powerprofilesctl; then
        powerprofilesctl set "$profile" 2>/dev/null || true
    fi

    case "$profile" in
        performance)
            pick_governor performance
            set_epp performance
            set_platform_profile performance
            ;;
        balanced)
            pick_governor balanced
            set_epp balance_power
            set_platform_profile balanced
            ;;
    esac
    printf 'Profil "%s" angewendet.\n' "$profile"
}

save_profile() {
    local profile="$1"
    install -d -m 0755 "$profile_dir"
    printf '%s\n' "$profile" >"$profile_file"
    apply_profile
}

case "${1:-status}" in
    status) show_status ;;
    apply)
        require_root apply
        apply_profile
        ;;
    performance)
        require_root performance
        save_profile performance
        ;;
    balanced)
        require_root balanced
        save_profile balanced
        ;;
    reset)
        require_root reset
        rm -f -- "$profile_file"
        apply_profile
        ;;
    -h | --help | help) usage ;;
    *)
        usage
        exit 2
        ;;
esac
