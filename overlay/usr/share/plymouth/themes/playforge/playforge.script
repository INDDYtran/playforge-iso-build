# Playforge – Boot-Splash «ASCII Brutal».
#
# Zwei vorgerenderte Frames werden überblendet: Das Basisbild bleibt stehen,
# der zweite Frame blendet Eckmarken und den Blockcursor ein. So entsteht ein
# blinkender Terminal-Cursor ohne Text und ohne Abhängigkeit von Schriftarten.

Window.SetBackgroundTopColor (0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor (0.0, 0.0, 0.0);

screen_width = Window.GetWidth ();
screen_height = Window.GetHeight ();

base = Image ("background.png");
base = base.Scale (screen_width, screen_height);
base_sprite = Sprite (base);
base_sprite.SetX (0);
base_sprite.SetY (0);
base_sprite.SetZ (0);

cursor = Image ("background-glow.png");
cursor = cursor.Scale (screen_width, screen_height);
cursor_sprite = Sprite (cursor);
cursor_sprite.SetX (0);
cursor_sprite.SetY (0);
cursor_sprite.SetZ (10);
cursor_sprite.SetOpacity (1);

tick = 0;
visible = 1;

fun blink () {
        tick = tick + 1;
        if (tick >= 30) {
                tick = 0;
                visible = 1 - visible;
                cursor_sprite.SetOpacity (visible);
        }
}

Plymouth.SetRefreshFunction (blink);
